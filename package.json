{
  "name": "@ban-sky/dsh-workbuddy",
  "version": "0.9.1",
  "description": "WorkBuddy / CodeBuddy models in DeepSeek Harness: browser sign-in, live model catalog, credit balance, multi-account isolation, and per-account token usage statistics.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "icon": "./icon.svg",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./lib/*.js": "./lib/*.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "workbuddy",
    "codebuddy",
    "model-provider"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:watch": "node --test --watch test/*.test.js",
    "build": "node scripts/build.mjs",
    "verify": "node --check index.js && node --check client.js && node --check lib/accounts.js && node --check lib/catalog.js && node --check lib/catalog-source.js && node --check lib/credentials.js && node --check lib/credits.js && node --check lib/http.js && node --check lib/jwt.js && node --check lib/oauth.js && node --check lib/promotions.js && node --check lib/shim.js && node --check lib/adapter.js && node --check lib/token-store.js && node --check lib/usage.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1,
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.4.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "license": "MIT",
  "author": "ban-sky",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ban-sky/dsh-workbuddy.git"
  },
  "homepage": "https://github.com/ban-sky/dsh-workbuddy#readme",
  "bugs": {
    "url": "https://github.com/ban-sky/dsh-workbuddy/issues"
  }
}
